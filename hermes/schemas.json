      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "actor",
        "run_id",
        "work_package_id",
        "outcome"
      ],
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "work_package_id": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "request_changes",
            "blocked"
          ]
        },
        "details": {
          "type": "object"
        }
      }
