    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "actor",
        "run_id",
        "closeout"
      ],
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "type": "string"
        },
