        "data"
      ],
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "work_package_id": {
          "type": "string"
        },
        "receipt_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    }
  },
  {
    "name": "campaign_reconcile",
    "title": "Reconcile work package",
    "description": "Accept, reject, request changes, or block a registered work package after parent review.",
