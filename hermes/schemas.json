          "type": "string"
        },
        "phase": {
          "type": "object"
        },
        "work_package_id": {
          "type": "string"
        },
        "work_package_status": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  },
  {
    "name": "campaign_finish",
    "title": "Finish campaign",
