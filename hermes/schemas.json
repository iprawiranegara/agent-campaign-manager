      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "actor",
        "run_id",
        "reason"
      ],
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "limitations": {
          "type": "array",
